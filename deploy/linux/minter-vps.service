[Unit]
Description=MINTER Tauri desktop over private noVNC
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=simple
User=minter
Group=minter
WorkingDirectory=/var/lib/minter
RuntimeDirectory=minter
RuntimeDirectoryMode=0700
Environment=HOME=/var/lib/minter
# Said outright rather than inferred from the working directory: the service
# and the desktop then agree on one place without depending on how either
# happens to be started.
Environment=MINTER_DATA_DIR=/var/lib/minter
Environment=XDG_RUNTIME_DIR=/run/minter
Environment=DISPLAY=:99
Environment=GDK_BACKEND=x11
Environment=MINTER_NOVNC_BIND=127.0.0.1:3021
Environment=MINTER_SCREEN=1440x900x24
ExecStart=/usr/bin/dbus-run-session -- /opt/minter/start-minter-vnc.sh
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=mixed

# xdg-document-portal uses the setuid fusermount3 helper to hand files chosen
# in the native picker to rfd. The remaining filesystem hardening stays on.
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/minter /run/minter
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
